# Core VLAN, bridge, multicast and CPU-routing scenarios.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
# Optional hardware TC scenarios also require driver ndo_setup_tc support.
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_ACT_GACT=y
CONFIG_NET_ACT_MIRRED=y
# Board-specific MAC, DSA switch and tag protocol drivers remain in board configs.
